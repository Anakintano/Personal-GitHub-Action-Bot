{
  "uid": "ci-failure-explainer",
  "title": "CI Failure Explainer",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "ci"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Analyses by category and source (15 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category, source) (increase(analyses_total[15m]))",
          "legendFormat": "{{category}} / {{source}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "LLM tokens (15 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llm_tokens_total[15m]))",
          "legendFormat": "Tokens"
        }
      ]
    },
    {
      "id": 3,
      "title": "LLM latency p95 (15 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_latency_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Rate limit events (15 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(rate_limited_total[15m]))",
          "legendFormat": "Rate limit events"
        }
      ]
    },
    {
      "id": 5,
      "title": "Analysis errors (15 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "ci-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(analysis_errors_total[15m]))",
          "legendFormat": "Errors"
        }
      ]
    }
  ]
}
